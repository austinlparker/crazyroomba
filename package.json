{
  "name": "crazy-roomba",
  "version": "2.10.0",
  "description": "A Crazy Taxi-inspired browser game where you control a roomba collecting dust",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --local --ip 127.0.0.1 --port 8787 --local-upstream 127.0.0.1:8787 --upstream-protocol http",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc && tsc -p tsconfig.worker.json && tsc -p tsconfig.tests.json && tsc -p tsconfig.worker-tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "node scripts/test-local.mjs api",
    "test:api:running": "node tests/api.integration.mjs",
    "test:browser": "node scripts/test-local.mjs browser",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:assets": "node scripts/check-assets.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:worker": "wrangler deploy --dry-run",
    "check": "npm run format:check && npm run check:assets && npm test && npm run build && npm run check:bundle && npm run check:worker",
    "db:local": "wrangler d1 migrations apply crazy-roomba-v2 --local",
    "db:remote": "wrangler d1 migrations apply crazy-roomba-v2 --remote",
    "cf:types": "wrangler types --include-runtime=false",
    "deploy": "npm run build && npm run check:assets && npm run check:bundle && wrangler deploy"
  },
  "dependencies": {
    "@atproto/crypto": "^0.5.4",
    "@atproto/oauth-client-browser": "^0.5.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260905.1",
    "@types/node": "^24.13.3",
    "@types/three": "^0.185.4",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^4.0.16",
    "wrangler": "^4.129.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
